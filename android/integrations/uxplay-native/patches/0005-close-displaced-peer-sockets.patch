--- a/lib/httpd.c
+++ b/lib/httpd.c
@@ -361,0 +362,11 @@
+httpd_remove_other_peer_connections_now(httpd_t *httpd, void *incoming, bool (*same_peer)(void *, void *)) {
+    for (int i = 0; i < httpd->max_connections; i++) {
+        http_connection_t *connection = &httpd->connections[i];
+        if (connection->connected && connection->user_data &&
+            connection->user_data != incoming && !same_peer(connection->user_data, incoming)) {
+            httpd_remove_connection(httpd, connection, 0);
+        }
+    }
+}
